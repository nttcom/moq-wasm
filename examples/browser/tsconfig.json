{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "customConditions": ["source"],
    "types": ["@types/dom-mediacapture-transform", "@types/react", "@types/react-dom", "vite/client"],
    "lib": ["esnext", "webworker", "dom"]
  },
  "include": [
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "examples/media/publisher/files/decoder.js",
    "lib/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
