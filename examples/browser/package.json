{
  "name": "browser-examples",
  "version": "1.0.0",
  "description": "moq-wasm client",
  "scripts": {
    "wasm": "wasm-pack build ../../sdk/js --target web --out-name moqt --out-dir=js/pkg",
    "wasm:dev": "wasm-pack build --dev ../../sdk/js --target web --out-name moqt --out-dir=js/pkg",
    "dev": "npm run wasm:dev && vite",
    "build": "npm run wasm && vite build",
    "lint": "tsc --noEmit",
    "docs": "npm run docs:js && npm run docs:python && npm run docs:rust",
    "docs:js": "npm --prefix ../../sdk/js/js/typedoc run docs -- --out ../../../../examples/browser/public/docs/js",
    "docs:python": "cd ../../sdk/python && uv run pdoc moq_wasm moq_wasm.media moq_wasm.codecs moq_wasm.pipecat -o ../../examples/browser/public/docs/python",
    "docs:rust": "cargo doc -p moq-wasm --no-deps --target-dir ../../target/rust-sdk-docs && rm -rf public/docs/rust && mkdir -p public/docs && cp -R ../../target/rust-sdk-docs/doc public/docs/rust",
    "test": "playwright test --config playwright.unit.config.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:media": "playwright test tests/media-e2e.spec.ts tests/media-cmaf-e2e.spec.ts tests/remote-broadcast-e2e.spec.ts",
    "e2e:meeting": "playwright test tests/meeting-e2e.spec.ts",
    "e2e:message": "playwright test tests/message-e2e.spec.ts",
    "e2e:datagram": "playwright test tests/datagram-e2e.spec.ts",
    "e2e:whiteboard": "playwright test tests/whiteboard-e2e.spec.ts",
    "e2e:live-viewer": "playwright test tests/live-viewer-e2e.spec.ts",
    "e2e:live-viewer-mp4": "playwright test tests/live-viewer-mp4-e2e.spec.ts",
    "e2e:live-viewer-delivery": "playwright test tests/live-viewer-delivery-e2e.spec.ts",
    "e2e:chat-moderation": "playwright test tests/chat-moderation-e2e.spec.ts",
    "e2e:meeting-transcription": "playwright test tests/meeting-transcription-e2e.spec.ts",
    "e2e:camera-detection": "playwright test tests/camera-detection-e2e.spec.ts",
    "e2e:ptz-tracking": "playwright test tests/ptz-tracking-e2e.spec.ts",
    "e2e:goaway": "playwright test tests/goaway-e2e.spec.ts",
    "e2e:live-translate": "playwright test tests/live-translate-e2e.spec.ts",
    "e2e:recorder-goaway": "playwright test tests/recorder-goaway-e2e.spec.ts",
    "e2e:console": "playwright test --config playwright.console.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@types/dom-mediacapture-transform": "^0.1.11",
    "lucide-react": "^1.56.0",
    "moq-wasm": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "picomatch": "^4.0.4"
  }
}
