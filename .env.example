# ONVIF credentials for Makefile targets
ONVIF_IP=
ONVIF_USERNAME=
ONVIF_PASSWORD=

# Relay authentication. Both are required; the relay refuses to start without them.
# `make relay` and `docker compose up` supply development defaults backed by
# services/vts/apps.example.json. Override them to run against your own ledger:
# AUTH_VTS_URL=http://vts:8081/verify
# AUTH_RELAY_TOKEN=<relay JWT minted with services/vts/bin/mint.mjs>
# VTS_APPS_FILE=/path/to/apps.json

# MoQ bridge
MOQT_URL=https://localhost:4433

# OpenTelemetry / OTLP SaaS backend, for example Honeycomb.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# Set headers required by your backend.
# Honeycomb example:
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your-api-key,x-honeycomb-dataset=moqt-relay
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your-api-key,x-honeycomb-dataset=moqt-relay
OTEL_SERVICE_NAME=relay
OTEL_SDK_DISABLED=false

# Logging filters
RELAY_STDOUT_FILTER=relay=info,moqt=info
RELAY_OTEL_FILTER=relay=info,moqt=info
RELAY_LOG_FILTER=relay=info,moqt=info
