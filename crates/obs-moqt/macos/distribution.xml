<?xml version="1.0" encoding="utf-8"?>
<!-- productbuild distribution of the macOS installer (`make obs-plugin-pkg`).
     The home directory is the only install domain: OBS loads user plugins from
     ~/Library/Application Support/obs-studio/plugins, and the installer then
     asks for no administrator password. -->
<installer-gui-script minSpecVersion="1">
    <title>obs-moqt</title>
    <options customize="never" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
    <choices-outline>
        <line choice="obs-moqt"/>
    </choices-outline>
    <choice id="obs-moqt" title="obs-moqt">
        <pkg-ref id="com.github.nttcom.moq-wasm.obs-moqt"/>
    </choice>
    <pkg-ref id="com.github.nttcom.moq-wasm.obs-moqt">obs-moqt.pkg</pkg-ref>
</installer-gui-script>
