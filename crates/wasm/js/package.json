{
  "name": "moq-wasm",
  "version": "0.6.0",
  "private": true,
  "description": "Media over QUIC Transport in the browser: sessions, publishing and playback",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/core/index.ts",
      "types": "./types/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./media": {
      "source": "./src/media/index.ts",
      "types": "./types/media/index.d.ts",
      "default": "./dist/media/index.js"
    },
    "./media/player.css": "./src/media/player/livePlayer.css",
    "./media/controls.css": "./src/media/controls/playerControls.css",
    "./recording": {
      "source": "./src/recording/index.ts",
      "types": "./types/recording/index.d.ts",
      "default": "./dist/recording/index.js"
    }
  },
  "scripts": {
    "wasm": "wasm-pack build ../ --target web --out-name moqt --out-dir=js/pkg",
    "wasm:dev": "wasm-pack build --dev ../ --target web --out-name moqt --out-dir=js/pkg",
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "lint:promises": "oxlint --type-aware src",
    "api:check": "api-extractor run --config api-extractor.core.json && api-extractor run --config api-extractor.media.json && api-extractor run --config api-extractor.recording.json",
    "api:update": "api-extractor run --local --config api-extractor.core.json && api-extractor run --local --config api-extractor.media.json && api-extractor run --local --config api-extractor.recording.json",
    "test": "playwright test --config playwright.unit.config.ts",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "files": [
    "dist",
    "types",
    "pkg/moqt.d.ts",
    "src/media/player/livePlayer.css",
    "src/media/controls/playerControls.css"
  ],
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007"
  }
}
